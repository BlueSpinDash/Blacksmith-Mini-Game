<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ForgePattern" parent="@android:style/Theme.Material.NoActionBar">
        <!-- matches the page background so there is no flash on launch and the
             system bars blend into the forge -->
        <item name="android:windowBackground">@color/forge_background</item>
        <item name="android:colorBackground">@color/forge_background</item>
        <item name="android:navigationBarColor">@color/forge_background</item>
        <item name="android:statusBarColor">@color/forge_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
